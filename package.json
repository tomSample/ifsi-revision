{
  "name": "ifsi-revision-app",
  "version": "2.0.0",
  "description": "Application de révision IFSI avec répétition espacée",
  "main": "src/backend/app.py",
  "scripts": {
    "generate:td-questions": "python scripts/generate-td-questions.py",
    "generate:ue26": "python scripts/generate-ue26-json.py",
    "sync-data": "npm run generate:td-questions && npm run generate:ue26 && node scripts/sync-data.js",
    "build": "npm run sync-data && npm run minify",
    "minify": "node minify.js",
    "dev": "npm run sync-data && python src/backend/app.py",
    "start": "npm run sync-data && python src/backend/app.py",
    "lint": "eslint src/frontend/assets/scripts/ --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "test": "echo \"Tests à implémenter\" && exit 0"
  },
  "keywords": [
    "ifsi",
    "revision",
    "spaced-repetition",
    "education",
    "medical"
  ],
  "author": "IFSI Lannion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomSample/ifsi-revision.git"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "python": ">=3.8.0"
  }
}
